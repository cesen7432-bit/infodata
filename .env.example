# Servidor
PORT=3000
NODE_ENV=development

# Postgres
DATABASE_URL=postgresql://expediente:expediente@localhost:5432/expediente_unico

# Redis
REDIS_URL=redis://localhost:6379

# Auth — sesión opaca guardada en BD, sin JWT ni secreto que gestionar
SESSION_TTL_HOURS=8

# DataDiverService
DATADIVERSERVICE_USER=
DATADIVERSERVICE_PASS=
DATADIVERSERVICE_BASE_URL=https://datadiverservice.com
DATADIVERSERVICE_API_URL=https://api.datadiverservice.com
QUEUE_CONCURRENCY_DATADIVERSERVICE=5

# SATJE — sin credenciales: la búsqueda es HTTP directo (ver README)
SATJE_API_BASE=https://api.funcionjudicial.gob.ec
QUEUE_CONCURRENCY_SATJE=5

# SRI
SRI_BASE_URL=https://srienlinea.sri.gob.ec/sri-en-linea/SriRucWeb/ConsultaRuc/Consultas/consultaRuc
SRI_CONTRIBUYENTE_URL=https://srienlinea.sri.gob.ec/sri-catastro-sujeto-servicio-internet/rest/ConsolidadoContribuyente/obtenerPorNumerosRuc
SRI_ESTABLECIMIENTOS_URL=https://srienlinea.sri.gob.ec/sri-catastro-sujeto-servicio-internet/rest/Establecimiento/consultarPorNumeroRuc
QUEUE_CONCURRENCY_SRI=2

# ANT
ANT_URL=https://consultaweb.ant.gob.ec/PortalWEB/paginas/clientes/clp_grid_citaciones.jsp
QUEUE_CONCURRENCY_ANT=2

# Puppeteer (login/sesión de DataDiverService, SRI y ANT)
HEADLESS=true
# Solo en Docker — ruta al Chromium instalado por el sistema (ver Dockerfile)
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser
